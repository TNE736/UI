# ─────────────────────────────────────────────────────────────
# LeadOps Studio — one settings file for the UI (Next.js) and the backend
# (backend/integrations/main.py loads this file). Copy to `.env`; it is gitignored.
# Ports come from the start commands; the URLs below carry host:port on localhost.
# ─────────────────────────────────────────────────────────────

# ── MongoDB (the system of record, shared with bench-outreach) ──
# directConnection=true lets Windows reach the single WSL mongod through the relay.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DB=bench_outreach
MONGODB_COLLECTION=consultants

# ── Addresses the BROWSER uses (NEXT_PUBLIC_ = visible to the browser) ──
NEXT_PUBLIC_INGEST_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_LIVE_UPDATES_URL=http://127.0.0.1:4100/events

# ── Browser origins the backend accepts (server-side only) ──
ALLOWED_WEB_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ── Logging (optional; defaults shown) ──
# LOG_CONSOLE=rendered          # backend/browser console: rendered | json
# NEXT_PUBLIC_LOG_CONSOLE=rendered
# OTEL_EXPORTER_OTLP_ENDPOINT=  # set to send traces to a collector
