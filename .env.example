# Copy to .env.local and adjust. .env.local is git-ignored.

# ── Server only: the new dashboard's read-only API routes query MongoDB directly ──
# Local WSL MongoDB through scripts/wsl_mongo_relay.py (in leadops-platform):
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
# Atlas later: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=bench_outreach
MONGODB_COLLECTION=consultants

# ── Browser: the existing leadops-platform services (unchanged) ──
NEXT_PUBLIC_INGEST_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_LIVE_UPDATES_URL=http://127.0.0.1:4100/events
